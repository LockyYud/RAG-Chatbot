OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4.1-mini
OPENAI_JUDGE_MODEL=gpt-4.1-mini

LLM_EMBEDDING_INPUT_COST_PER_1K=0.00002
LLM_CHAT_INPUT_COST_PER_1K=0.00015
LLM_CHAT_OUTPUT_COST_PER_1K=0.0006

# Only needed if a technique uses an API-backed cross-encoder (e.g.
# bm25_hybrid_rerank with reranker_backend="api"). Flat cost per rerank call,
# not per-token — most hosted rerank APIs bill per search unit, not tokens.
# LLM_RERANK_COST_PER_CALL=0.001
# COHERE_API_KEY=
# JINA_AI_API_KEY=

RAGLAB_SYNTHETIC_QA_LIMIT=50
RAGLAB_BENCHMARK_OUTPUT=benchmarks/results/sample_research
