# OpenAI-compatible API configuration.
# For OpenAI, keep OPENAI_BASE_URL as https://api.openai.com/v1.
# For compatible gateways/local proxies, point it to the gateway's /v1 base URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Model defaults used by configs/pipelines/openai_rag.yaml.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Optional cost estimation. Leave 0 if you do not want cost metrics.
# Values are USD per 1K tokens and are intentionally not hard-coded.
OPENAI_CHAT_INPUT_COST_PER_1K=0
OPENAI_CHAT_OUTPUT_COST_PER_1K=0
OPENAI_EMBEDDING_INPUT_COST_PER_1K=0
